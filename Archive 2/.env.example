# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite              # used for the final evaluation
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest   # the interviewer's voice
GEMINI_VOICE=Aoede

# LiveKit Cloud project (https://cloud.livekit.io) — use a separate project from Dora
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PORT=3000

# SkillSetu FastAPI backend (session heartbeats)
SKILLSETU_API_URL=http://127.0.0.1:8000
